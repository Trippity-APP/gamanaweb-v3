"use client";

import { useState } from "react";
import Image from "next/image";
import { ShoppingCart, Minus, Plus, X, Check, Coins, Smartphone, Headphones } from "lucide-react";
import { Button } from "@/components/ui/button";
import {
  Sheet,
  SheetContent,
  SheetHeader,
  SheetTitle,
  SheetTrigger,
} from "@/components/ui/sheet";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";
import { useCart } from "@/lib/cart-context";
import { useAccount } from "@/lib/account-context";
import { PersonalizeNudge } from "@/components/PersonalizeNudge";

type PaymentMethod = "coins";

/**
 * This cart is Tours/Combos only — audio content is paid for exclusively with Gamana
 * Coins, never real-money rails. (Real-money purchases live in the separate
 * ExperiencesCart, which uses Credit Card / RazorPay depending on the traveler's
 * location.) Keeping the two payment rails visually distinct — "Audio Tours" here,
 * "Experiences" over there — avoids implying you can buy a Story/Tour with a credit card.
 */

export function MarketplaceCart() {
  const { items, removeItem, updateQuantity, clearCart, itemCount, subtotal } = useCart();
  const { account, journey, addOrder } = useAccount();
  const [cartOpen, setCartOpen] = useState(false);
  const [checkoutOpen, setCheckoutOpen] = useState(false);
  const [checkoutStep, setCheckoutStep] = useState<"nudge" | "payment" | "confirmed">("payment");
  const [paymentMethod, setPaymentMethod] = useState<PaymentMethod | null>(null);
  const [orderNumber, setOrderNumber] = useState("");

  const openCheckout = () => {
    setCartOpen(false);
    setCheckoutStep(!account || !journey ? "nudge" : "payment");
    setPaymentMethod(null);
    setCheckoutOpen(true);
  };

  const placeOrder = () => {
    const id = `GMN-${Math.floor(100000 + Math.random() * 900000)}`;
    setOrderNumber(id);
    addOrder({
      id,
      kind: "audio",
      items: items.map((i) => ({ title: i.title, quantity: i.quantity, price: i.price })),
      total: subtotal,
      placedAt: new Date().toISOString(),
    });
    setCheckoutStep("confirmed");
  };

  const closeCheckout = () => {
    setCheckoutOpen(false);
    if (checkoutStep === "confirmed") clearCart();
  };

  return (
    <>
      <Sheet open={cartOpen} onOpenChange={setCartOpen}>
        <SheetTrigger asChild>
          <Button
            size="icon"
            className="fixed bottom-6 right-6 z-40 h-14 w-14 rounded-full bg-gradient-to-r from-[#159895] to-[#1A5F7A] shadow-xl hover:shadow-2xl hover:scale-105 transition-all"
            aria-label="Open cart"
          >
            <ShoppingCart className="h-6 w-6" />
            {itemCount > 0 && (
              <span className="absolute -top-1 -right-1 h-6 w-6 rounded-full bg-red-500 text-white text-xs font-bold flex items-center justify-center border-2 border-white">
                {itemCount > 99 ? "99+" : itemCount}
              </span>
            )}
          </Button>
        </SheetTrigger>

        <SheetContent side="right" className="flex flex-col w-full sm:max-w-md">
          <SheetHeader>
            <SheetTitle>Your Cart ({itemCount})</SheetTitle>
          </SheetHeader>

          {items.length === 0 ? (
            <div className="flex-1 flex flex-col items-center justify-center text-center gap-2 text-gray-500">
              <ShoppingCart className="h-10 w-10 text-gray-300" />
              <p>Your cart is empty.</p>
              <p className="text-sm text-gray-400">Add tours or combos to get started.</p>
            </div>
          ) : (
            <>
              <div className="flex-1 overflow-y-auto py-4 space-y-4">
                {items.map((item) => (
                  <div key={`${item.type}-${item.id}`} className="flex gap-3 border-b border-gray-100 pb-4">
                    <div className="relative w-16 h-16 rounded-lg overflow-hidden shrink-0 bg-gray-100">
                      <Image src={item.image} alt={item.title} fill className="object-cover" />
                    </div>
                    <div className="flex-1 min-w-0">
                      <p className="text-sm font-semibold text-gray-900 truncate">{item.title}</p>
                      <p className="text-xs text-gray-500 capitalize">{item.type}</p>
                      <div className="flex items-center justify-between mt-2">
                        <div className="flex items-center gap-2">
                          <button
                            type="button"
                            aria-label="Decrease quantity"
                            onClick={() => updateQuantity(item.id, item.type, item.quantity - 1)}
                            className="w-6 h-6 rounded-full border border-gray-300 flex items-center justify-center text-gray-600 hover:border-[#159895] hover:text-[#159895]"
                          >
                            <Minus className="h-3 w-3" />
                          </button>
                          <span className="text-sm w-4 text-center">{item.quantity}</span>
                          <button
                            type="button"
                            aria-label="Increase quantity"
                            onClick={() => updateQuantity(item.id, item.type, item.quantity + 1)}
                            className="w-6 h-6 rounded-full border border-gray-300 flex items-center justify-center text-gray-600 hover:border-[#159895] hover:text-[#159895]"
                          >
                            <Plus className="h-3 w-3" />
                          </button>
                        </div>
                        <p className="text-sm font-semibold text-gray-900">
                          {item.price === 0 ? "Free" : `$${(item.price * item.quantity).toFixed(2)}`}
                        </p>
                      </div>
                    </div>
                    <button
                      type="button"
                      aria-label="Remove item"
                      onClick={() => removeItem(item.id, item.type)}
                      className="text-gray-300 hover:text-red-500 shrink-0"
                    >
                      <X className="h-4 w-4" />
                    </button>
                  </div>
                ))}
              </div>

              <div className="border-t border-gray-100 pt-4 space-y-3">
                <div className="flex items-center justify-between text-sm text-gray-600">
                  <span>Subtotal</span>
                  <span className="font-semibold text-gray-900">${subtotal.toFixed(2)}</span>
                </div>
                <Button
                  onClick={openCheckout}
                  className="w-full bg-gradient-to-r from-[#159895] to-[#1A5F7A] hover:from-[#159895] hover:to-[#1A5F7A]"
                >
                  Checkout
                </Button>
                <button
                  type="button"
                  onClick={clearCart}
                  className="w-full text-xs text-gray-400 hover:text-red-500"
                >
                  Clear cart
                </button>
              </div>
            </>
          )}
        </SheetContent>
      </Sheet>

      <Dialog open={checkoutOpen} onOpenChange={(open) => (open ? setCheckoutOpen(true) : closeCheckout())}>
        <DialogContent className="sm:max-w-md">
          {checkoutStep === "nudge" && (
            <>
              <DialogHeader className="sr-only">
                <DialogTitle>Before you check out</DialogTitle>
              </DialogHeader>
              <PersonalizeNudge onContinue={() => setCheckoutStep("payment")} />
            </>
          )}

          {checkoutStep === "payment" && (
            <>
              <DialogHeader>
                <DialogTitle>Choose how to pay</DialogTitle>
              </DialogHeader>

              <div className="bg-gray-50 rounded-xl p-4 space-y-1 text-sm">
                {items.map((item) => (
                  <div key={`${item.type}-${item.id}`} className="flex justify-between text-gray-600">
                    <span className="truncate pr-2">
                      {item.title} {item.quantity > 1 ? `× ${item.quantity}` : ""}
                    </span>
                    <span className="shrink-0">
                      {item.price === 0 ? "Free" : `$${(item.price * item.quantity).toFixed(2)}`}
                    </span>
                  </div>
                ))}
                <div className="flex justify-between font-semibold text-gray-900 pt-2 border-t border-gray-200 mt-2">
                  <span>Total</span>
                  <span>${subtotal.toFixed(2)}</span>
                </div>
              </div>

              <div className="flex items-center gap-1.5 pt-1 text-[11px] font-semibold uppercase tracking-wide text-gray-400">
                <Headphones className="h-3.5 w-3.5" />
                Audio Tours · Gamana Coins
              </div>
              <div className="grid gap-3">
                <button
                  type="button"
                  onClick={() => setPaymentMethod("coins")}
                  className={`flex items-center gap-3 rounded-xl border-2 p-3 text-left transition-all ${
                    paymentMethod === "coins" ? "border-[#159895] bg-[#159895]/5" : "border-gray-200 hover:border-[#159895]/40"
                  }`}
                >
                  <Coins className="h-5 w-5 text-[#159895]" />
                  <div>
                    <p className="text-sm font-semibold text-gray-900">Pay with Gamana Coins</p>
                    <p className="text-xs text-gray-500">Uses your coin balance in the app</p>
                  </div>
                </button>
              </div>
              <p className="text-[11px] text-gray-400">
                Tours, Topics, and Combos are audio content and are only ever paid for with
                Gamana Coins. Looking to book a real-world Experience? Those use Credit Card /
                RazorPay checkout instead — see the Experiences cart.
              </p>

              <Button
                onClick={placeOrder}
                disabled={!paymentMethod}
                className="w-full mt-2 bg-gradient-to-r from-[#159895] to-[#1A5F7A] hover:from-[#159895] hover:to-[#1A5F7A]"
              >
                Place Order
              </Button>
              <p className="text-[11px] text-gray-400 text-center">
                Prototype note: no real payment is processed here.
              </p>
            </>
          )}

          {checkoutStep === "confirmed" && (
            <div className="text-center space-y-4 py-2">
              <div className="w-14 h-14 rounded-full bg-green-100 flex items-center justify-center mx-auto">
                <Check className="h-7 w-7 text-green-600" />
              </div>
              <DialogHeader>
                <DialogTitle className="text-center">Order Confirmed</DialogTitle>
              </DialogHeader>
              <p className="text-sm text-gray-600">
                Order <span className="font-semibold text-gray-900">{orderNumber}</span> is ready. Open the
                Gamana app to start listening.
              </p>
              <div className="bg-gray-50 rounded-xl p-4 text-sm text-gray-600 flex items-center gap-2 justify-center">
                <Smartphone className="h-4 w-4 text-[#159895]" />
                Everything you bought will sync to your account in the app.
              </div>
              <Button
                onClick={closeCheckout}
                className="w-full bg-gradient-to-r from-[#159895] to-[#1A5F7A] hover:from-[#159895] hover:to-[#1A5F7A]"
              >
                Done
              </Button>
              <p className="text-[11px] text-gray-400">
                Prototype note: this order isn&apos;t saved anywhere real yet.
              </p>
            </div>
          )}
        </DialogContent>
      </Dialog>
    </>
  );
}
