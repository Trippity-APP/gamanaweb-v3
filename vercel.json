{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/landing",
      "destination": "/download-app/",
      "permanent": true
    },
    {
      "source": "/explore",
      "destination": "/marketplace/",
      "permanent": true
    },
    {
      "source": "/explore/tours/:id",
      "destination": "/marketplace/tours/:id/",
      "permanent": true
    },
    {
      "source": "/explore/story/:id",
      "destination": "/marketplace/story/:id/",
      "permanent": true
    },
    {
      "source": "/explore/tours",
      "destination": "/marketplace/tours/",
      "permanent": true
    },
    {
      "source": "/explore/story",
      "destination": "/marketplace/story/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://apidev.gamana.app/api/v1/:path*"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/__spa__/"
    },
    {
      "source": "/blog/:slug/",
      "destination": "/blog/__spa__/"
    },
    {
      "source": "/cities/:id",
      "destination": "/cities/__spa__/"
    },
    {
      "source": "/cities/:id/",
      "destination": "/cities/__spa__/"
    },
    {
      "source": "/explore/tours/:id",
      "destination": "/marketplace/tours/__spa__/"
    },
    {
      "source": "/explore/tours/:id/",
      "destination": "/marketplace/tours/__spa__/"
    },
    {
      "source": "/explore/story/:id",
      "destination": "/marketplace/story/__spa__/"
    },
    {
      "source": "/explore/story/:id/",
      "destination": "/marketplace/story/__spa__/"
    },
    {
      "source": "/marketplace/tours/:id",
      "destination": "/marketplace/tours/__spa__/"
    },
    {
      "source": "/marketplace/tours/:id/",
      "destination": "/marketplace/tours/__spa__/"
    },
    {
      "source": "/storylist/:id",
      "destination": "/storylist/__spa__/"
    },
    {
      "source": "/storylist/:id/",
      "destination": "/storylist/__spa__/"
    },
    {
      "source": "/storylists/:id",
      "destination": "/storylists/__spa__/"
    },
    {
      "source": "/storylists/:id/",
      "destination": "/storylists/__spa__/"
    },
    {
      "source": "/marketplace/story/:id",
      "destination": "/marketplace/story/__spa__/"
    },
    {
      "source": "/marketplace/story/:id/",
      "destination": "/marketplace/story/__spa__/"
    }
  ]
}
