{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/marketplace",
      "destination": "/explore",
      "permanent": true
    },
    {
      "source": "/marketplace/tours/:id",
      "destination": "/explore/tours/:id",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://apidev.gamana.app/api/v1/:path*"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/[slug]/index.html"
    },
    {
      "source": "/cities/:id",
      "destination": "/cities/[id]/index.html"
    },
    {
      "source": "/explore/tours/:id",
      "destination": "/explore/tours/[id]/index.html"
    },
    {
      "source": "/marketplace/tours/:id",
      "destination": "/explore/tours/[id]/index.html"
    },
    {
      "source": "/storylist/:id",
      "destination": "/storylist/[id]/index.html"
    },
    {
      "source": "/storylists/:id",
      "destination": "/storylists/[id]/index.html"
    }
  ]
}
