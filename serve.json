{
  "cleanUrls": true,
  "trailingSlash": true,
  "directoryListing": false,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/landing",
      "destination": "/download-app/",
      "permanent": true
    },
    {
      "source": "/marketplace",
      "destination": "/explore/",
      "permanent": true
    },
    {
      "source": "/marketplace/tours/:id",
      "destination": "/explore/tours/:id/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/blog/__spa__/index.html"
    },
    {
      "source": "/cities/:id",
      "destination": "/cities/__spa__/index.html"
    },
    {
      "source": "/explore/tours/:id",
      "destination": "/explore/tours/__spa__/index.html"
    },
    {
      "source": "/explore/story/:id",
      "destination": "/explore/story/__spa__/index.html"
    },
    {
      "source": "/marketplace/tours/:id",
      "destination": "/explore/tours/__spa__/index.html"
    },
    {
      "source": "/storylist/:id",
      "destination": "/storylist/__spa__/index.html"
    },
    {
      "source": "/storylists/:id",
      "destination": "/storylists/__spa__/index.html"
    }
  ]
}
