#!/usr/bin/env bash
# Blocks pushes to live branches from this working copy.
protected='^(main|master|beta|dev|webux|testing_experiences_10oct)$'
while read -r local_ref local_sha remote_ref remote_sha; do
  branch="${remote_ref#refs/heads/}"
  if [[ "$branch" =~ $protected ]]; then
    echo "BLOCKED: pushing to '$branch' is not allowed. Push a web-accounts/* branch and open a PR." >&2
    exit 1
  fi
done
exit 0
