# Runtime proxy target for same-origin /api/v1/* and /api/v2/* (scripts/serve-out.mjs, next dev rewrites)
API_PROXY_TARGET=https://api-beta.gamana.app

# Build-time fetches (static generation)
NEXT_PUBLIC_API_URL=https://api-beta.gamana.app/api/v1

# Google Identity Services (web login)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Sign in with Apple JS (web login, popup flow)
NEXT_PUBLIC_APPLE_SERVICES_ID=app.gamana.web
NEXT_PUBLIC_APPLE_REDIRECT_URI=https://www.gamana.app/login/

# Feature flag for all logged-in features (login, account, wallet, collection, booking). 0 in production until rollout.
NEXT_PUBLIC_WEB_ACCOUNTS=0

# Return URLs and canonical links
NEXT_PUBLIC_SITE_URL=https://www.gamana.app

# Google Maps (meeting points, city autocomplete)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
